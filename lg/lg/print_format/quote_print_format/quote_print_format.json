 "font_size": 14,
 "html": "\r\n<div class=\"header-table\">\r\n  <table>\r\n\r\n    <tr style=\"\">/\r\n      <td class=\"logo\">\r\n        <img src=\"files/LG.png\" alt=\"Company Logo\" style=\"\">\r\n      </td>\r\n      <td class=\"company-details\">\r\n        <h1><b>Gravity Printech India Private Limited</b></h1>\r\n        <p>SCO - 8, 3rd Floor, PPR Mall, Jalandhar, Punjab, 144003, India</p>\r\n        <p>Phone: 01814156009, 01814150077 | Email: mail@gravityprintech.com</p>\r\n        <p>CIN: U74300PB2019PTC049244 | GSTIN: 03AAHCG7507L1ZI <br>\r\n        </p><br>\r\n                <p style=\"text-align:left; font-size:18px;font-weight:bold !important;margin-bottom: 0px;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;QUOTATION</p>\r\n\r\n\r\n      </td>\r\n     \r\n    </tr>\r\n  </table>\r\n  <!--<p style=\"text-align:center; font-size:18px;\"><b>&nbsp;&nbsp;&nbsp;&nbsp;QUOTATION</b></p>-->\r\n  \r\n</div>\r\n\r\n<table class=\"details-table\" style=\"font-size:11px; table-layout: fixed; width: 100%; border-collapse: collapse;border:none;\">\r\n<tr>\r\n    <!-- Bill To (width adjusted to prevent overlap) -->\r\n    <td colspan=\"2\" class=\"company-name\" style=\"width: 50%; line-height: 1.2; padding: 5px; font-size: 10px; word-break: break-word;\">\r\n        <b>Bill To:</b> {{ doc.customer_name | default(\"\", true) }}\r\n    </td>\r\n    \r\n    <!-- Quote No. (fixed width to avoid overflow) -->\r\n    <td style=\"width: 15%; padding: 5px; line-height: 1.2;\">\r\n        <b>Quote No.:</b>\r\n    </td>\r\n    \r\n    <!-- Quote Number (auto width) -->\r\n    <td style=\"padding: 5px; line-height: 1.2;\">\r\n        {{ doc.name }}\r\n    </td>\r\n</tr>\r\n    <td colspan=\"2\" rowspan=\"7\" class=\"address\" style=\"vertical-align: top; padding: 5px;line-height: 1;\">\r\n\r\n<div>\r\n  {%if doc.customer_address%}\r\n<strong>Address:</strong> {% set p = frappe.get_doc(\"Address\", doc.customer_address) %}\r\n{{p.address_title}}<br>\r\n{{p.address_line1}}<br>\r\n{{ p.address_line2}}<br>\r\n{{ p.city}}<br>\r\n{{ p.state }}State Code : 03 <br>\r\n PinCode : {{ p.pincode}}<br><br>\r\n \r\nGSTIN : {{ p.gstin }}\r\n{%endif%}\r\n</div>\r\n      <br>\r\n      {%if doc.shipping_address_name%}\r\n      <div><b>Ship To:</b> </div>{% set p = frappe.get_doc(\"Address\", doc.shipping_address_name) %}\r\n{{p.address_title}}<br>\r\n{{p.address_line1}}<br>\r\n{{ p.address_line2}}<br>\r\n{{ p.city}}<br>\r\n{{ p.state }}State Code : 03 <br>\r\n PinCode : {{ p.pincode}}<br><br>\r\n \r\nGSTIN : {{ p.gstin }}\r\n    </td>{%endif%}\r\n    <td style=\"padding: 5px;margin:0px;line-height: 0.3;\"><b>Quote Date:</b></td>\r\n        {% if doc.transaction_date %}\r\n\r\n    <td style=\"padding: 5px;margin-bottom:0px;line-height: 0.3;\">{{ frappe.utils.get_datetime(doc.transaction_date).strftime('%d-%m-%Y') }}</td>\r\n    {% endif %}\r\n  </tr>\r\n  \r\n  \r\n  </tr>\r\n  {%if doc.contact_display %}\r\n  <tr>\r\n      \r\n    <td style=\"padding: 5px;line-height: 0.3;\"><b>Contact Name:</b></td>\r\n    <td style=\"padding: 5px;line-height: 0.3;\">{{ doc.contact_display }}</td>{%endif%}\r\n  </tr>\r\n  <tr>\r\n  {% if doc.contact_person %}\r\n    {% set c = frappe.get_doc('Contact', doc.contact_person) %}\r\n    <td style=\"padding: 5px; line-height: 0.3;\"><b>Contact Phone:</b></td>\r\n    <td style=\"padding: 5px; line-height: 0.3;\">\r\n      {% for i in c.phone_nos %}\r\n        {{ i.phone }}{% if not loop.last %}, {% endif %}\r\n      {% endfor %}\r\n    </td>\r\n  {% endif %}\r\n</tr>\r\n {%if doc.contact_person%}\r\n  <tr>\r\n    <td style=\"padding: 5px;line-height: 0.3;width:50%\"><b>Contact Email:</b></td>\r\n    <td style=\"padding: 5px;line-height: 0.3;\">\r\n       \r\n         {% set p =frappe.get_doc(\"Contact\",doc.contact_person | default(\"\",true))%}\r\n         {{p.email_id | default(\"\",true)}} {%endif%}\r\n      <!--{% if email_ids %}-->\r\n      <!--  {% for row in contact.email_ids %}-->\r\n      <!--    {{ row.email_id }}<br>-->\r\n      <!--  {% endfor %}-->\r\n      <!--{% endif %}-->\r\n    </td>\r\n  </tr>\r\n  {%if doc.custom_delivered_by_%}\r\n  <tr>\r\n    <td style=\"padding: 5px;line-height: 0.3;\"><b>Dispatch Mode:</b></td>\r\n    <td style=\"padding: 5px;line-height: 0.3;\">{{doc.custom_delivered_by_|default(\"\",true)}}</td>\r\n  </tr>{%endif%}\r\n  <tr>\r\n    <td style=\"padding: 5px; height: auto;line-height: 0.3;\"><b>Destination:</b></td>\r\n    <td style=\"padding: 5px;line-height: 0.3;\">\r\n        {{frappe.db.get_value(\"Address\", doc.customer_address, 'city')}}\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n\r\n\r\n <table style=\"margin-top:0px;margin-bottom:0px;font-size:11px; width:100%;\">\r\n        <thead>\r\n            <tr style=\"\">\r\n                \r\n                <th>S.No</th>\r\n                <th width=\"40%\">Item</th>\r\n                <th width=\"40%\">Description</th>\r\n                <th width=\"10%\">Quantity</th>\r\n                <th width=\"10%\">Rate</th>\r\n                <th width=\"10%\">Amount</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n           \r\n          \r\n                {% for i in doc.items%}\r\n            <tr>\r\n                \r\n                <td>{{i.idx}}</td>\r\n                <td>{{i.item_name}}</td>\r\n                <td>{{i.description}}</td>\r\n                <td> {{\"{:,.0f}\".format(i.qty)}}</td>\r\n                <td> {{\"{:,.2f}\".format(i.rate)}}</td>\r\n                <td> {{\"{:,.2f}\".format(i.amount)}}</td>\r\n            </tr>\r\n            {%endfor%}\r\n            \r\n            <tr class=\"total-row\">\r\n                <td colspan=\"5\" class=\"total-label\" style=\"border-right:1px solid black;\">SUB TOTAL:</td>\r\n                <td class=\"amount-cell\"> {{\"{:,.2f}\".format(doc.total or 0)}}</td>\r\n            </tr>\r\n              {%if doc.taxes_and_charges%}\r\n            {% if \"In-state sale\" in doc.taxes_and_charges%}\r\n            \r\n           <tr class=\"total-row\">\r\n                <td colspan=\"5\" class=\"total-label\" style=\"border-right:1px solid black;\">SGST</td>\r\n                <td class=\"amount-cell\">\r\n                    \r\n                   \r\n                {% for i in doc.taxes %}\r\n    {% if i.account_head == \"Output SGST - GPIPL\" %}\r\n        {{\"{:,.2f}\".format(i.base_tax_amount)}}\r\n    {% endif %}\r\n{% endfor %}\r\n                </td>\r\n            </tr>\r\n            <tr class=\"total-row\">\r\n                <td colspan=\"5\" class=\"total-label\" style=\"border-right:1px solid black;\">CGST</td>\r\n                <td class=\"amount-cell\">\r\n                    \r\n                    \r\n                    \r\n                    {%endif%}\r\n                    {%endif%}\r\n                   \r\n                {% for i in doc.taxes %}\r\n    {% if i.account_head == \"Output CGST - GPIPL\" %}\r\n        {{\"{:,.2f}\".format(i.base_tax_amount)}}\r\n    {% endif %}\r\n{% endfor %}\r\n                </td>\r\n            </tr>\r\n            \r\n {% if doc.taxes_and_charges%}\r\n           {% if \"Out State Sale\" in doc.taxes_and_charges%}\r\n            <tr class=\"total-row\">\r\n                <td colspan=\"5\" class=\"total-label\" style=\"border-right:1px solid black;\">IGST</td>\r\n                <td class=\"amount-cell\">\r\n                    \r\n                   \r\n                {% for i in doc.taxes %}\r\n    {% if i.account_head == \"Output IGST - GPIPL\" %}\r\n        {{\"{:,.2f}\".format(i.base_tax_amount)}}\r\n    {% endif %}\r\n{% endfor %}\r\n                </td>\r\n            </tr>\r\n\r\n            {%endif%}\r\n            \r\n            \r\n            {%endif%}\r\n            \r\n            \r\n            \r\n            \r\n            \r\n            \r\n            \r\n            \r\n            \r\n            \r\n            \r\n            \r\n\r\n            \r\n   <tr class=\"total-row\">\r\n    <td colspan=\"5\" class=\"total-label\" style=\"border-right:1px solid black;\">\r\n        {% if doc.currency == \"USD\" %}Grand Total (USD){% else %}Grand Total (INR){% endif %}\r\n    </td>\r\n    <td class=\"amount-cell\">\r\n        {% if doc.currency == \"USD\" %}\r\n            ${{ \"%.2f\"|format(doc.total_usd|float or 0) }}\r\n        {% else %}\r\n            \u20b9{{ \"%.2f\"|format(doc.total_usd|float or 0) }}\r\n        {% endif %}\r\n    </td>\r\n</tr>\r\n        </tbody>\r\n    </table>\r\n    \r\n    \r\n    \r\n     <table style=\"font-size:11px;\">\r\n        <tr>\r\n            <td colspan=\"2\" class=\"total-words\">Total In Words : {{doc.in_words}}</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"label-column\" style=\"width:20%\">Payment Terms</td>\r\n            <td style=\"text-align:center;\">{{doc.payment_terms_template | default(\"\",true)}}</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"label-column\">Bank Account</td>\r\n            <td style=\"text-align:center;\">924030040940539</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"label-column\">Bank Name</td>\r\n            <td style=\"text-align:center;\">Axis Bank (India)</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"label-column\">Branch Name</td>\r\n            <td style=\"text-align:center;\">Badri Dass Colony, Mahaveer Marg, Near B.M.C Chowk,Jalandhar (PB)</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"label-column\">IFSC Code</td>\r\n            <td style=\"text-align:center;\">UTIB0000155</td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"2\" class=\"terms-conditions\">\r\n                <strong>Terms & Conditions :</strong>\r\n                <ol class=\"terms-list\" style=\"border-bottom:hidden;\">\r\n                    {{doc.terms | default(\"\",true)}}\r\n                    <!--<li>All disputes subject to Jalandhar jurisdiction</li>-->\r\n                    <!--<li>Terms of Delivery: Dispatch after receipt of Purchase Order</li>-->\r\n                </ol>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n  \r\n  \r\n  \r\n  \r\n  \r\n   <table class=\"\" style=\"width:100%;\">\r\n    \r\n        <tr>\r\n            {% set fl  = frappe.get_doc(\"User\",doc.owner)%}\r\n            <td width=30%>Quoted By: {{fl.full_name}}</td>\r\n            \r\n            <td width=30%></td>\r\n            <td width=30%>Verified By</td>\r\n        </tr>\r\n    </table>\r\n    \r\n    \r\n    \r\n        <!--<table style=\"font-size:11px\">-->\r\n        <!--    <tr>-->\r\n        <!--        <td>Buyer</td>-->\r\n        <!--        <td>{{doc.customer_address}}</td>-->\r\n        <!--        <td>Seller</td>-->\r\n        <!--        <td>{{doc.shipping_address}}</td>-->\r\n        <!--    </tr>-->\r\n        <!--    <tr>-->\r\n        <!--        <td>Date</td>-->\r\n        <!--        <td>{{ frappe.utils.get_datetime(doc.transaction_date).strftime('%d-%m-%Y') }}</td>-->\r\n        <!--        <td>Date</td>-->\r\n        <!--        <td>{{ frappe.utils.get_datetime(doc.transaction_date).strftime('%d-%m-%Y') }}</td>-->\r\n        <!--    </tr>-->\r\n        <!--</table>-->\r\n        \r\n      \r\n   \r\n    \r\n</div>\r\n",
