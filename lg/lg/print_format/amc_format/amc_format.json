 "font_size": 14,
 "html": "<div style=\"font-family: Arial, sans-serif; font-size: 12px; border: 1px solid #000; padding: 0px;\">\n\n    <!-- Header with Logo -->\n    <table style=\"width: 100%;\">\n        <tr>\n            <td style=\"width: 40%; vertical-align: middle;\">\n                <img src=\"/files/HI_M.png\" alt=\"Hi-M. Solutek\" style=\"max-height: 80px;\">\n            </td>\n            <td style=\"width: 60%; text-align: centre; font-size: 14px; font-weight: bold;\">\n                Hi-M. Solutek India Pvt. Ltd. <br>\n                <span style=\"font-size: 12px; font-weight: normal;\">\n                    Regd Office: A-24/6 Mohan Cooperative Industrial Estate, Mathura Road, New Delhi - 110044 <br>\n                    GST NO: 07AAACH6450M1ZD\n                </span>\n            </td>\n        </tr>\n    </table><br>\n    <!-- Title -->\n<!-- Top horizontal line -->\n<div style=\"border-top: 1px solid #000; margin-bottom: 5px;\"></div>\n\n<!-- Annexure title below the line -->\n<div style=\"text-align: center; font-weight: bold; font-size: 14px; margin-bottom: 3px;\">\n    ANNEXURE \"A\"\n</div>\n\n<!-- Bottom line (if needed) -->\n<div style=\"border-bottom: 1px solid #000; margin-bottom: 10px;\"></div>\n\n\n\n <div style=\"text-align: center; font-weight: bold; font-size: 14px; border-bottom: 1px solid #000; padding-bottom: 1px; margin-bottom: 10px;\">\n   ANNUAL MAINTENANCE CONTRACT <br>\n    \n</div>\n\n\n    <!-- Billing & Installation Address -->\n    <!-- Billing & Installation Address -->\n<!-- Billing & Installation Address -->\n<table style=\"width: 100%; border-collapse: collapse; font-size: 12px; border-bottom: 1px solid #000;\">\n    <tr>\n        <td style=\"width: 30%; padding: 4px; border-right: 1px solid #000; border-bottom: none;\">\n            \n            <b>To Billing Address :</b><br>\n            {% if doc.customer_address %}\n                {% set billing = frappe.get_doc(\"Address\", doc.billing_address) %}\n                {{ billing.address_line1 }}<br>\n                {{ billing.address_line2 }}<br>\n                {{ billing.city }}, {{ billing.state }} - {{ billing.custom_pin_code}}<br>\n                {{ billing.country }}\n            {% endif %}\n        <td style=\"width: 70%; vertical-align: top; padding: 8px;\">\n            <b>Shipping Address :</b><br>\n            {% if doc.shipping_address%}\n            {% set shipping = frappe.get_doc(\"Address\",doc.shipping_address)%}\n            {{shipping.address_line1}}\n            {{shipping.address_line2}}\n            {{ shipping.city }},  {{shipping.state }} - {{ shipping.custom_pin_code}},{{shipping.country}}<br>\n\n            {% endif %}\n        </td>\n    </tr>\n</table>\n\n\n    <!-- Warranty Note -->\n    <p style=\"font-size: 12px;\">\n        Dear Sir/Mam, <br>\n        We are pleased to inform you that the warranty of installed LG Air Conditioners at the above address has been going to expire on \n        <b>{{ doc.expiry_date }}</b>. We are pleased to offer our competitive quote for the maintenance contract as below:-\n    </p>\n\n    <!-- Items Table -->\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\" border=\"1\" cellpadding=\"4\">\n        <thead>\n            <tr style=\"background-color: #f0f0f0; text-align: center;\">\n                <th>Model No.</th>\n                <th>Serial No</th>\n                <th>Contract Type</th>\n                <th>Capacity</th>\n                <th>Unit</th>\n                <th>Qty</th>\n                <th>Rate/Hp</th>\n                <th>Amount</th>\n            </tr>\n        </thead>\n        \n        <tbody>\n            \n            {% for item in doc.product_details %}\n            <tr>\n                <td>{{ item.model_no}} </td>\n                <td>{{ item.serial_no }}</td>\n                <td>{{ doc.deal_type}}</td>\n                <td>{{ doc.total_hp}}</td>\n                <td>{{ item.hp}}</td>\n                <td> HP</td>\n                <td>{{doc.price_rate}}</td>\n                <td>{{doc.amount}}</dt>\n                \n            </tr>\n            {% endfor %}\n           \n        </tbody>\n    </table>\n\n    <p style=\"font-size: 11px; margin-top: 5px;\">\n        Note: This contract includes the Indoor Units installed along with the mentioned Outdoor Units.\n    </p>\n\n    <!-- Amount Summary -->\n    <table style=\"width: 100%; font-size: 12px; margin-top: 10px;\" cellpadding=\"2\">\n        <tr>\n            <td style=\"width: 70%;\"></td>\n            <td style=\"text-align:right;\">Basic Amount:</td>\n            <td style=\"text-align:right;\">{{ doc.basic_amount }}</td>\n        </tr>\n        <tr>\n            <td></td>\n            <td style=\"text-align:right;\">GST @ 18%:</td>\n            <td style=\"text-align:right;\">{{ doc.gst_amount }}</td>\n        </tr>\n        <tr style=\"font-weight: bold;\">\n            <td></td>\n            <td style=\"text-align:right;\">Grand Total:</td>\n            <td style=\"text-align:right;\">{{ doc.grand_total }}</td>\n        </tr>\n    </table>\n\n    <p style=\"font-size: 12px; margin-top: 10px;\">\n        Amount in Words: <b>{{ doc.in_words }}</b>\n    </p>\n\n    <!-- Payment Terms -->\n    <p style=\"font-size: 12px;\">\n        <b>Payment Terms:</b> 100% Advance in favour of \"Hi-M. Solutek India Pvt. Ltd.\"\n    </p>\n\n    <br><br>\n\n    <!-- Footer -->\n    <div style=\"width: 100%; font-size: 12px;\">\n        <div style=\"float: left; width: 50%;\">\n            <b>For Hi-M. Solutek India Pvt. Ltd.</b><br><br><br>\n            Vishnu Dipak Tiwari <br>\n            Area Manager - Delhi\n        </div>\n        <div style=\"float: right; width: 40%; text-align: center;\">\n            Customer\u2019s Signature\n        </div>\n    </div>\n\n</div>\n",
